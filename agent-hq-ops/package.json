{
  "name": "agent-hq-ops",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "e2e": "node tests/e2e/run.mjs",
    "build:artifact": "npm run build && node scripts/inline.mjs",
    "e2e:artifact": "node tests/e2e/artifact.mjs",
    "e2e:live": "vite build --mode e2e-live --outDir dist-e2e-live --emptyOutDir && node scripts/inline.mjs dist-e2e-live dist-e2e-live/single.html && node tests/e2e/live.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.10.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
